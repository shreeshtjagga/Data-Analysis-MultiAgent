# ─── DataPulse Environment Variables ─────────────────────────────────────────
# Cloud Database (Commented out)
# DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>/<database>
# DB_SSL=true
# REDIS_URL=redis://<password>@<host>:<port>

# Local Database (Active)
DATABASE_URL=sqlite+aiosqlite:///./datapulse.db
DB_SSL=false
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_BYTES=26214400
CACHE_TTL_ANALYSIS=259200
CACHE_TTL_SESSION=86400

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here